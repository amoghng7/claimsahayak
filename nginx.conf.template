# Rate-limit zone for the Gemini proxy (http context — this template is
# included from conf.d). $binary_remote_addr survives envsubst: the nginx
# image only substitutes defined environment variables.
limit_req_zone $binary_remote_addr zone=gemini:1m rate=20r/m;

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # --- Security headers ---
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # connect-src allows the Gemini BYOK override, plus Firebase Auth endpoints.
    # script-src allows the Google Identity Services popup. frame-src allows the
    # OAuth popup iframe. img-src allows Google profile photos.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://generativelanguage.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://apis.google.com https://claim-sahayak.firebaseapp.com; frame-ancestors 'none';" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- Secure Backend Proxy for Gemini ---
    location = /api/gemini/generate {
        # Only allow POST requests
        limit_except POST {
            deny all;
        }

        # Abuse protection: 20 req/min per client IP, short burst, JSON errors
        limit_req zone=gemini burst=10 nodelay;
        limit_req_status 429;
        # PDF text payloads are small; 4 MB is generous headroom
        client_max_body_size 4m;

        # Sidecar in the same container calls Vertex AI with the Cloud Run
        # service account (ADC) — no API key material in this config at all.
        proxy_pass http://127.0.0.1:8081/generate;
        proxy_set_header Host $host;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;

        # Map upstream 5xx/timeouts to a JSON 502 instead of an HTML error page
        proxy_intercept_errors on;
        error_page 429 = @json429;
        error_page 500 502 503 504 = @upstream_error;

        # Prevent forwarding client IP to Google
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    # --- Case history + document archive (Phase 06 step 6.4, consent-gated) ---
    location /api/cases {
        limit_except GET PUT DELETE {
            deny all;
        }

        limit_req zone=gemini burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 1m;

        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;

        proxy_intercept_errors on;
        error_page 429 = @json429;
        error_page 500 502 503 504 = @upstream_error;

        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    location = /api/uploads {
        limit_except POST {
            deny all;
        }

        limit_req zone=gemini burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 15m;

        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;

        proxy_intercept_errors on;
        error_page 429 = @json429;
        error_page 500 502 503 504 = @upstream_error;

        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    location @json429 {
        default_type application/json;
        return 429 '{"error":"rate_limited","message":"Too many requests — wait a minute and retry."}';
    }

    # --- OCR for scanned documents (Phase 06 step 6.2) → sidecar → Document AI ---
    location = /api/ocr {
        limit_except POST {
            deny all;
        }

        limit_req zone=gemini burst=10 nodelay;
        limit_req_status 429;
        # Scanned PDFs/photos as base64; Document AI online limit is 20 MB binary
        client_max_body_size 15m;

        proxy_pass http://127.0.0.1:8081/ocr;
        proxy_set_header Host $host;

        proxy_connect_timeout 10s;
        # OCR of a multi-page scan is slower than a text round-trip
        proxy_read_timeout 120s;

        proxy_intercept_errors on;
        error_page 429 = @json429;
        error_page 500 502 503 504 = @upstream_error;

        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    location @upstream_error {
        default_type application/json;
        return 502 '{"error":"upstream_unavailable","message":"The analysis service is unavailable right now."}';
    }

    # --- SPA routing: serve index.html for all paths ---
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- ES module workers (pdf.js): nginx mime.types has no .mjs mapping,
    #     and module scripts are rejected unless served as JavaScript ---
    location ~* \.mjs$ {
        default_type text/javascript;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # --- Cache static assets aggressively ---
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # --- Disable server version disclosure ---
    server_tokens off;

    # --- Gzip compression ---
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
}
