# Powers the dev-server middleware for /api/gemini/generate (npm run dev).
# Server-side only — never bundled into the client.
# Not needed when GEMINI_SIDECAR_URL is set.
GEMINI_API_KEY=

# Optional: route the dev proxy through a locally running sidecar instead of a
# dev key — the production-shaped path (npm run dev:server in another shell;
# needs Application Default Credentials, e.g. gcloud auth application-default login).
GEMINI_SIDECAR_URL=
